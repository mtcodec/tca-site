              }
            }
          },
          "requires_restart": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "enum_labels": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "hidden": {
            "type": [
              "boolean",
              "null"
