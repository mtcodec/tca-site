          },
          "terminal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "default": {},
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "current": {},
              "enum_labels": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "group": {
